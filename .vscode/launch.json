{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: запустить сервер",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Проверить пример (19 модулей)",
      "type": "python",
      "request": "launch",
      "module": "app.cli",
      "args": [
        "tests/fixtures/project_l_shape_19modules.dbs"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Проверить свой файл .dbs",
      "type": "python",
      "request": "launch",
      "module": "app.cli",
      "args": [
        "${input:dbsPath}"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Тесты",
      "type": "python",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "dbsPath",
      "type": "promptString",
      "description": "Путь к файлу проекта .dbs (от папки backend или полный)",
      "default": "tests/fixtures/project_l_shape_19modules.dbs"
    }
  ]
}
