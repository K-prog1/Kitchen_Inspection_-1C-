{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Установка 1/2: создать окружение",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "venv",
        ".venv"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Установка 2/2: поставить зависимости",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Установка (один раз)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Установка 1/2: создать окружение",
        "Установка 2/2: поставить зависимости"
      ],
      "problemMatcher": []
    },
    {
      "label": "Запустить API",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Проверить пример (19 модулей)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "app.cli",
        "tests/fixtures/project_l_shape_19modules.dbs"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Запустить тесты",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Открыть сайт в браузере (Windows)",
      "type": "shell",
      "command": "Start-Process",
      "args": [
        "${workspaceFolder}\\site\\index.html"
      ],
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-Command"
          ]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Открыть страницы в браузере (Windows)",
      "type": "shell",
      "command": "Start-Sleep -Seconds 3; Start-Process 'http://127.0.0.1:8000/'; Start-Process 'http://127.0.0.1:8000/docs'",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-Command"
          ]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Запустить всё (сервер и страницы)",
      "dependsOn": [
        "Запустить API",
        "Открыть страницы в браузере (Windows)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
